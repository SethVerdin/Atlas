# Atlas configuration. `npm run setup` copies this file to .env if .env doesn't exist.
# .env is git-ignored. Never commit real passwords or API keys.

# ---- PostgreSQL (used by docker-compose.yml and the API) ----
DB_HOST=localhost
DB_PORT=5433
DB_NAME=atlas
DB_USER=postgres
# Any password you like for your local database. Set it before the first
# `docker compose up`; changing it later requires resetting the database volume.
DB_PASSWORD=change_me_local_only

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=3000

# ---- AI agent (used by POST /v1/chat and the app's Ask screen) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Food data (the agent's search_foods tool) ----
# Optional: without a key the API uses USDA's shared DEMO_KEY, which is heavily rate limited.
# Get a key at https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=
